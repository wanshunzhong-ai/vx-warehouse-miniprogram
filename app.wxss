/* ============ 全局设计变量与基础样式 ============ */

page {
  background: #f4f6fa;
  color: #151922;
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Helvetica, Arial, sans-serif;
  -webkit-font-smoothing: antialiased;
}

view, text, input, textarea, button, scroll-view {
  box-sizing: border-box;
}

/* ---------- 布局 ---------- */

.page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.page-tab {
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
}

.wrap {
  padding: 24rpx 28rpx;
}

.row {
  display: flex;
  align-items: center;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.col {
  display: flex;
  flex-direction: column;
}

.grow {
  flex: 1;
  min-width: 0;
}

/* ---------- 卡片 ---------- */

.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 6rpx 24rpx rgba(21, 25, 34, 0.055);
}

.card + .card {
  margin-top: 24rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #151922;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* ---------- 文字 ---------- */

.t-main {
  color: #151922;
}

.t-sub {
  color: #6b7280;
}

.t-dim {
  color: #9aa1ad;
}

.t-primary {
  color: #2f6df6;
}

.t-in {
  color: #16a34a;
}

.t-out {
  color: #f97316;
}

.f-xs {
  font-size: 22rpx;
}

.f-sm {
  font-size: 26rpx;
}

.f-md {
  font-size: 30rpx;
}

.f-lg {
  font-size: 36rpx;
}

.f-xl {
  font-size: 48rpx;
}

.bold {
  font-weight: 600;
}

.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* ---------- 按钮 ---------- */

.btn {
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 20rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  padding: 0;
}

.btn::after {
  border: none;
}

.btn-primary {
  background: linear-gradient(135deg, #3d7bff, #2f6df6);
  color: #ffffff;
  box-shadow: 0 10rpx 24rpx rgba(47, 109, 246, 0.28);
}

.btn-in {
  background: linear-gradient(135deg, #22c55e, #16a34a);
  color: #ffffff;
  box-shadow: 0 10rpx 24rpx rgba(22, 163, 74, 0.25);
}

.btn-out {
  background: linear-gradient(135deg, #fb923c, #f97316);
  color: #ffffff;
  box-shadow: 0 10rpx 24rpx rgba(249, 115, 22, 0.25);
}

.btn-ghost {
  background: #eef2fa;
  color: #2f6df6;
}

.btn-plain {
  background: #f2f4f8;
  color: #4b5563;
}

.btn-danger {
  background: #fef2f2;
  color: #ef4444;
}

.btn-disabled {
  opacity: 0.5;
}

.btn-sm {
  height: 64rpx;
  line-height: 64rpx;
  font-size: 26rpx;
  padding: 0 28rpx;
  border-radius: 16rpx;
  font-weight: 500;
}

/* ---------- 标签 ---------- */

.tag {
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
  font-size: 22rpx;
  line-height: 32rpx;
}

.tag-blue {
  background: #eaf1ff;
  color: #2f6df6;
}

.tag-green {
  background: #e9f9ef;
  color: #16a34a;
}

.tag-orange {
  background: #fff3e6;
  color: #ea580c;
}

.tag-red {
  background: #feecec;
  color: #ef4444;
}

.tag-gray {
  background: #f1f3f7;
  color: #6b7280;
}

.tag-purple {
  background: #f1ebff;
  color: #7c4dff;
}

/* ---------- 提示条 ---------- */

.notice {
  padding: 22rpx 26rpx;
  border-radius: 18rpx;
  font-size: 25rpx;
  line-height: 1.6;
  margin-bottom: 24rpx;
}

.notice-blue {
  background: #eef4ff;
  color: #2f6df6;
  border: 1rpx solid #dbe6ff;
}

.notice-purple {
  background: #f3efff;
  color: #6d3df0;
  border: 1rpx solid #e6dcff;
}

.notice-green {
  background: #e9f9ef;
  color: #16a34a;
  border: 1rpx solid #d5f2e0;
}

.notice-red {
  background: #fef2f2;
  color: #dc2626;
  border: 1rpx solid #fbe0e0;
}

/* ---------- 表单 ---------- */

.field {
  display: flex;
  align-items: center;
  min-height: 104rpx;
  border-bottom: 1rpx solid #eef1f6;
}

.field:last-child {
  border-bottom: none;
}

.field-label {
  width: 180rpx;
  color: #4b5563;
  font-size: 28rpx;
  flex-shrink: 0;
}

.field-input {
  flex: 1;
  font-size: 28rpx;
  color: #151922;
  text-align: right;
}

.field-input-left {
  text-align: left;
}

.field-placeholder {
  color: #b9bfc9;
}

.textarea {
  width: 100%;
  min-height: 180rpx;
  padding: 24rpx;
  background: #f7f8fb;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #151922;
  margin-top: 16rpx;
}

/* ---------- 空态 ---------- */

.empty {
  padding: 120rpx 40rpx;
  text-align: center;
}

.empty-icon {
  width: 160rpx;
  height: 160rpx;
  margin: 0 auto 28rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #eef2fb, #e2e9f8);
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-title {
  font-size: 30rpx;
  color: #4b5563;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #9aa1ad;
  line-height: 1.6;
}

/* ---------- 列表项 ---------- */

.list-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f1f3f7;
}

.list-item:last-child {
  border-bottom: none;
}

/* ---------- 分隔 ---------- */

.divider {
  height: 1rpx;
  background: #eef1f6;
  margin: 24rpx 0;
}

.sec-title {
  font-size: 26rpx;
  color: #8a9099;
  padding: 32rpx 4rpx 16rpx;
  font-weight: 500;
}
