.req {
  color: #ef4444;
  margin-right: 6rpx;
}

.field-action {
  margin-left: 16rpx;
  padding: 10rpx 26rpx;
  background: #eef3ff;
  color: #2f6df6;
  border-radius: 12rpx;
  font-size: 24rpx;
  flex-shrink: 0;
}

.field-static {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: #151922;
  font-weight: 600;
}

.cat-chips,
.unit-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  padding: 16rpx 0 8rpx;
}

.chip {
  padding: 10rpx 24rpx;
  background: #f4f6fa;
  border-radius: 24rpx;
  font-size: 24rpx;
  color: #4b5563;
  border: 1rpx solid #eef1f6;
}

.chip-on {
  background: #2f6df6;
  color: #ffffff;
  border-color: #2f6df6;
}

.chip-sm {
  font-size: 24rpx;
}

.submit {
  margin-top: 40rpx;
  width: 100%;
}

.err-box {
  margin-top: 28rpx;
  padding: 20rpx 24rpx;
  background: #fef2f2;
  border-radius: 14rpx;
  font-size: 26rpx;
  color: #dc2626;
  line-height: 1.5;
}

.hint {
  margin-top: 28rpx;
  font-size: 22rpx;
  color: #a3a9b3;
  line-height: 1.6;
  text-align: center;
}
