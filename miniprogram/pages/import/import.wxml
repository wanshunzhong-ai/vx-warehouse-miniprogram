<view class="page">
  <view class="wrap">
    <view class="card">
      <view class="card-title">
        <text>粘贴物品清单</text>
        <text class="t-primary f-sm" bindtap="fillSample">填入示例</text>
      </view>

      <view class="col-hint">
        每行一个物品，列顺序：编号、名称、规格、类别、单位、位置、库存、安全库存、备注。
        编号留空会自动生成。
      </view>

      <textarea
        class="textarea import-textarea"
        value="{{raw}}"
        placeholder="从 Excel 复制整块区域，直接粘贴到这里"
        placeholder-class="field-placeholder"
        maxlength="-1"
        bindinput="onRawInput"
      />

      <view class="btn-row">
        <view class="btn btn-plain grow" bindtap="pasteFromClipboard" hover-class="hover">读取剪贴板</view>
        <view class="btn btn-ghost grow" bindtap="parse" hover-class="hover">解析预览</view>
      </view>
    </view>

    <view wx:if="{{errors.length > 0}}" class="card err-card">
      <view class="card-title">有 {{errors.length}} 行需要修正</view>
      <view wx:for="{{errors}}" wx:key="*this" class="err-line">{{item}}</view>
    </view>

    <view wx:if="{{rows.length > 0}}" class="card">
      <view class="card-title">
        <text>预览（共 {{rows.length}} 条）</text>
        <text class="t-dim f-sm">{{preview.length === rows.length ? '全部' : '前 ' + preview.length + ' 条'}}</text>
      </view>
      <view wx:for="{{preview}}" wx:key="index" class="pv-item">
        <view class="pv-idx">{{index + 1}}</view>
        <view class="grow">
          <view class="f-md ellipsis">{{item.name}}</view>
          <view class="f-xs t-dim" style="margin-top:6rpx">
            {{item.code || '自动生成'}}{{item.spec ? ' · ' + item.spec : ''}}{{item.location ? ' · ' + item.location : ''}}
          </view>
        </view>
        <view class="pv-qty">{{item.qty}} {{item.unit}}</view>
      </view>
    </view>

    <view wx:if="{{progress}}" class="card progress-card">
      <view class="f-md t-primary">{{progress}}</view>
      <view class="f-xs t-dim" style="margin-top:10rpx">请保持页面打开，不要退出小程序</view>
    </view>

    <button
      wx:if="{{rows.length > 0}}"
      class="btn btn-primary submit {{importing ? 'btn-disabled' : ''}}"
      loading="{{importing}}"
      disabled="{{importing}}"
      bindtap="doImport"
    >{{importing ? '导入中…' : '开始导入 ' + rows.length + ' 个物品'}}</button>

    <view class="hint">
      导入后每个物品都会有独立编号与二维码，可在物品详情里保存二维码，
      或用电脑端工具批量打印标签。
    </view>
  </view>
</view>
