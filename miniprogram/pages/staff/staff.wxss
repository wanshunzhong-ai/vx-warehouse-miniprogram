/* ---------- 顶部概览 ---------- */

.head {
  padding: 36rpx 32rpx 28rpx;
  background: linear-gradient(140deg, #f3efff 0%, #f7f5ff 100%);
  border-bottom: 1rpx solid #ece4ff;
}

.head-manager {
  background: linear-gradient(140deg, #ecf2ff 0%, #f5f8ff 100%);
  border-bottom: 1rpx solid #e2ebff;
}

.head-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #151922;
}

.head-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #7a828e;
  line-height: 1.6;
}

.ov-row {
  display: flex;
  margin-top: 28rpx;
}

.ov-cell {
  flex: 1;
  text-align: center;
}

.ov-num {
  font-size: 46rpx;
  font-weight: 700;
  color: #151922;
  line-height: 1.15;
}

.ov-lbl {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8b8f99;
}

.c-admin { color: #7c4dff; }
.c-manager { color: #2f6df6; }
.c-staff { color: #0ca678; }
.c-warn { color: #f97316; }

/* ---------- 搜索与筛选 ---------- */

.search-bar {
  padding: 20rpx 28rpx 8rpx;
}

.search-wrap {
  display: flex;
  align-items: center;
  height: 84rpx;
  padding: 0 24rpx;
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 18rpx rgba(21, 25, 34, 0.05);
}

.search-ico {
  position: relative;
  width: 30rpx;
  height: 30rpx;
  border: 4rpx solid #b9bfc9;
  border-radius: 50%;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.search-ico::after {
  content: '';
  position: absolute;
  right: -12rpx;
  bottom: -8rpx;
  width: 16rpx;
  height: 4rpx;
  background: #b9bfc9;
  border-radius: 2rpx;
  transform: rotate(45deg);
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #151922;
}

.search-clear {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #eef1f6;
  color: #9aa1ad;
  font-size: 30rpx;
  text-align: center;
  line-height: 42rpx;
  flex-shrink: 0;
}

.chips {
  white-space: nowrap;
  padding: 20rpx 28rpx 4rpx;
}

.chip {
  display: inline-block;
  padding: 12rpx 30rpx;
  margin-right: 16rpx;
  background: #ffffff;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #4b5563;
  border: 1rpx solid #eef1f6;
}

.chip-on {
  background: #2f6df6;
  color: #ffffff;
  border-color: #2f6df6;
  font-weight: 500;
}

/* ---------- 账号卡片 ---------- */

.staff-card {
  padding: 28rpx 28rpx 24rpx;
}

.sc-head {
  display: flex;
  align-items: center;
}

.sc-avatar {
  width: 84rpx;
  height: 84rpx;
  border-radius: 26rpx;
  background: linear-gradient(135deg, #eef2fb, #e2e9f8);
  color: #4b6cb7;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 22rpx;
  flex-shrink: 0;
}

.sc-name-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.sc-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #151922;
  margin-right: 14rpx;
}

.sc-name-row .tag {
  margin-right: 10rpx;
}

.sc-meta {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #9aa1ad;
}

.sc-body {
  margin-top: 22rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #f1f3f7;
}

.sc-line {
  display: flex;
  align-items: flex-start;
  padding: 8rpx 0;
}

.sc-k {
  width: 150rpx;
  flex-shrink: 0;
  font-size: 24rpx;
  color: #9aa1ad;
}

.sc-v {
  flex: 1;
  font-size: 25rpx;
  color: #4b5563;
  word-break: break-all;
}

.sc-actions {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
}

.sc-hint {
  font-size: 23rpx;
  color: #b0b6c0;
}

/* ---------- 空态 ---------- */

.empty {
  padding: 100rpx 40rpx;
  text-align: center;
}

.empty-icon {
  width: 160rpx;
  height: 160rpx;
  margin: 0 auto 28rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #eef2fb, #e2e9f8);
  display: flex;
  align-items: center;
  justify-content: center;
}

.ei-user {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 6rpx solid #b9c6dd;
}

.empty-title {
  font-size: 30rpx;
  color: #4b5563;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #9aa1ad;
  line-height: 1.6;
}

/* ---------- 底部按钮与提示 ---------- */

.add-btn {
  width: 100%;
  margin-top: 32rpx;
}

.tips {
  margin-top: 32rpx;
  text-align: center;
  font-size: 22rpx;
  color: #a3a9b3;
  line-height: 1.7;
}
