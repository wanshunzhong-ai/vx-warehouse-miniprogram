.loading-box {
  padding: 200rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.spinner {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 6rpx solid #dfe5f0;
  border-top-color: #2f6df6;
  animation: spin 0.8s linear infinite;
  margin-bottom: 24rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.item-head {
  background: linear-gradient(160deg, #3d7bff 0%, #2456d8 100%);
  padding: 44rpx 36rpx 96rpx;
  border-bottom-left-radius: 44rpx;
  border-bottom-right-radius: 44rpx;
}

/* 已停用：整个头部换成中性灰，一眼看出状态 */
.head-archived {
  background: linear-gradient(160deg, #8b93a3 0%, #5f6775 100%);
}

.ih-title-row {
  display: flex;
  align-items: center;
}

.ih-badge {
  margin-left: 20rpx;
  padding: 6rpx 20rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.24);
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  font-size: 22rpx;
  color: #ffffff;
  flex-shrink: 0;
}

.archived-notice {
  margin-bottom: 24rpx;
}

.ih-name {
  font-size: 42rpx;
  font-weight: 600;
  color: #ffffff;
  line-height: 1.3;
}

.ih-meta {
  margin-top: 14rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.78);
  letter-spacing: 1rpx;
}

.ih-qty-row {
  margin-top: 36rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}

.ih-qty {
  font-size: 76rpx;
  font-weight: 600;
  color: #ffffff;
  line-height: 1;
}

.ih-qty-lbl {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.72);
}

.ih-warn {
  padding: 10rpx 24rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 30rpx;
  font-size: 22rpx;
  color: #ffffff;
}

.body {
  padding: 0 28rpx 60rpx;
  margin-top: -56rpx;
}

/* ---------- 操作按钮 ---------- */

.act-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.act {
  flex: 1;
  height: 104rpx;
  line-height: 104rpx;
  text-align: center;
  border-radius: 22rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
}

.act-in {
  background: linear-gradient(135deg, #22c55e, #16a34a);
  box-shadow: 0 10rpx 24rpx rgba(22, 163, 74, 0.24);
}

.act-out {
  background: linear-gradient(135deg, #fb923c, #f97316);
  box-shadow: 0 10rpx 24rpx rgba(249, 115, 22, 0.24);
}

/* ---------- 二维码 ---------- */

.qr-box {
  display: flex;
  justify-content: center;
  padding: 20rpx 0 8rpx;
}

.qr-canvas {
  width: 380rpx;
  height: 380rpx;
  background: #ffffff;
  border: 1rpx solid #eef1f6;
  border-radius: 16rpx;
}

.qr-code-text {
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #151922;
  letter-spacing: 2rpx;
  margin-top: 20rpx;
}

.qr-tip {
  text-align: center;
  font-size: 22rpx;
  color: #9aa1ad;
  margin-top: 10rpx;
  line-height: 1.5;
}

.qr-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 30rpx;
}

.qr-actions .btn {
  flex: 1;
}

/* ---------- 档案 ---------- */

.info-row {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f7fa;
}

.info-row:last-child {
  border-bottom: none;
}

.info-lbl {
  width: 180rpx;
  font-size: 26rpx;
  color: #8a9099;
  flex-shrink: 0;
}

.info-val {
  flex: 1;
  font-size: 28rpx;
  color: #151922;
  line-height: 1.5;
}

/* ---------- 位置照片 ---------- */

/* 用 padding 撑出固定比例，图没下完也不会让卡片跳高度 */
.photo-box {
  position: relative;
  width: 100%;
  padding-top: 72%;
  border-radius: 20rpx;
  overflow: hidden;
  background: #f2f5fa;
}

.photo-img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

/* 压一层渐变底，保证提示字在任何照片底色上都读得清 */
.photo-hint {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 48rpx 20rpx 16rpx;
  font-size: 22rpx;
  color: #ffffff;
  text-align: center;
  background: linear-gradient(to top, rgba(10, 14, 22, 0.62), rgba(10, 14, 22, 0));
}

.photo-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}

.photo-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 24rpx 4rpx;
}

/* 相机图标：项目不带图片资源，图标一律用 CSS 画 */
.pe-cam {
  position: relative;
  width: 100rpx;
  height: 74rpx;
  border: 4rpx solid #c9d2e0;
  border-radius: 16rpx;
  margin-bottom: 26rpx;
}

/* 顶部取景凸起：无下边框、不填色，让机身那道横线自然接上 */
.pe-cam::before {
  content: '';
  box-sizing: border-box;
  position: absolute;
  left: 50%;
  top: -24rpx;
  width: 38rpx;
  height: 24rpx;
  margin-left: -19rpx;
  border: 4rpx solid #c9d2e0;
  border-bottom: none;
  border-radius: 10rpx 10rpx 0 0;
}

.pe-lens {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 36rpx;
  height: 36rpx;
  margin: -18rpx 0 0 -18rpx;
  border: 4rpx solid #c9d2e0;
  border-radius: 50%;
}

.pe-lens::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 10rpx;
  height: 10rpx;
  margin: -5rpx 0 0 -5rpx;
  border-radius: 50%;
  background: #c9d2e0;
}

.pe-tip {
  font-size: 30rpx;
  font-weight: 600;
  color: #151922;
  margin-bottom: 12rpx;
}

.pe-sub {
  font-size: 25rpx;
  color: #8a9099;
  text-align: center;
  line-height: 1.6;
}

/* ---------- 记录 ---------- */

.rec-dot {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #ffffff;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.dot-in { background: linear-gradient(135deg, #22c55e, #16a34a); }
.dot-out { background: linear-gradient(135deg, #fb923c, #f97316); }

/* ---------- 底部 ---------- */

.foot-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 36rpx;
}

.notfound {
  text-align: center;
  padding: 56rpx 40rpx;
}

.nf-title {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.nf-desc {
  font-size: 26rpx;
  color: #8a9099;
  margin-bottom: 36rpx;
}
