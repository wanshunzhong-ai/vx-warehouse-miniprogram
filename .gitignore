# 依赖（体积大，按 package.json 安装即可）
node_modules/

# 微信开发者工具的本地个人配置（含本机路径与调试开关）
project.private.config.json

# WorkBuddy 本地运行数据（会话、项目记忆等，与代码无关）
.workbuddy/

# WorkBuddy 应用元数据（本机发布信息，与代码无关）
.wbapp_*

# 文档出图的本地工作区（截图母版、slidep 中间产物、打包缓存，共十几 MB，
# 可由 .render/build.js + screens.js 从页面源码重新生成，不入库）
.render/

# 含明文演示密码的内部账号表（仓库为公开仓库，禁止入库）
*账号表*
*-accounts.html
# 上述表的工作目录（含 build 脚本里的明文密码）
*.ref/

# 编辑器 / 系统
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log
