.loading-box {
  padding: 200rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.spinner {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 6rpx solid #dfe5f0;
  border-top-color: #2f6df6;
  animation: spin 0.8s linear infinite;
  margin-bottom: 24rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.item-head {
  background: linear-gradient(160deg, #3d7bff 0%, #2456d8 100%);
  padding: 44rpx 36rpx 96rpx;
  border-bottom-left-radius: 44rpx;
  border-bottom-right-radius: 44rpx;
}

.ih-name {
  font-size: 42rpx;
  font-weight: 600;
  color: #ffffff;
  line-height: 1.3;
}

.ih-meta {
  margin-top: 14rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.78);
  letter-spacing: 1rpx;
}

.ih-qty-row {
  margin-top: 36rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}

.ih-qty {
  font-size: 76rpx;
  font-weight: 600;
  color: #ffffff;
  line-height: 1;
}

.ih-qty-lbl {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.72);
}

.ih-warn {
  padding: 10rpx 24rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 30rpx;
  font-size: 22rpx;
  color: #ffffff;
}

.body {
  padding: 0 28rpx 60rpx;
  margin-top: -56rpx;
}

/* ---------- 操作按钮 ---------- */

.act-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.act {
  flex: 1;
  height: 104rpx;
  line-height: 104rpx;
  text-align: center;
  border-radius: 22rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
}

.act-in {
  background: linear-gradient(135deg, #22c55e, #16a34a);
  box-shadow: 0 10rpx 24rpx rgba(22, 163, 74, 0.24);
}

.act-out {
  background: linear-gradient(135deg, #fb923c, #f97316);
  box-shadow: 0 10rpx 24rpx rgba(249, 115, 22, 0.24);
}

/* ---------- 二维码 ---------- */

.qr-box {
  display: flex;
  justify-content: center;
  padding: 20rpx 0 8rpx;
}

.qr-canvas {
  width: 380rpx;
  height: 380rpx;
  background: #ffffff;
  border: 1rpx solid #eef1f6;
  border-radius: 16rpx;
}

.qr-code-text {
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #151922;
  letter-spacing: 2rpx;
  margin-top: 20rpx;
}

.qr-tip {
  text-align: center;
  font-size: 22rpx;
  color: #9aa1ad;
  margin-top: 10rpx;
  line-height: 1.5;
}

.qr-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 30rpx;
}

.qr-actions .btn {
  flex: 1;
}

/* ---------- 档案 ---------- */

.info-row {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f7fa;
}

.info-row:last-child {
  border-bottom: none;
}

.info-lbl {
  width: 180rpx;
  font-size: 26rpx;
  color: #8a9099;
  flex-shrink: 0;
}

.info-val {
  flex: 1;
  font-size: 28rpx;
  color: #151922;
  line-height: 1.5;
}

/* ---------- 记录 ---------- */

.rec-dot {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #ffffff;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.dot-in { background: linear-gradient(135deg, #22c55e, #16a34a); }
.dot-out { background: linear-gradient(135deg, #fb923c, #f97316); }

/* ---------- 底部 ---------- */

.foot-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 36rpx;
}

.notfound {
  text-align: center;
  padding: 56rpx 40rpx;
}

.nf-title {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.nf-desc {
  font-size: 26rpx;
  color: #8a9099;
  margin-bottom: 36rpx;
}
