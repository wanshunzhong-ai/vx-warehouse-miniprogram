<view class="page page-tab">
  <!-- 搜索 -->
  <view class="search-bar">
    <view class="search-wrap">
      <view class="search-ico"></view>
      <input
        class="search-input"
        value="{{keyword}}"
        placeholder="搜索名称 / 编号 / 规格 / 位置"
        placeholder-class="field-placeholder"
        confirm-type="search"
        bindinput="onKeywordInput"
        bindconfirm="reload"
      />
      <view wx:if="{{keyword}}" class="search-clear" bindtap="clearKeyword" hover-class="hover">×</view>
    </view>
  </view>

  <!-- 状态筛选：只有能停用/恢复物品的人（主管及以上）才需要看历史档案 -->
  <view wx:if="{{caps.item_archive}}" class="segs">
    <view
      class="seg {{status === 'active' ? 'seg-on' : ''}}"
      data-status="active"
      bindtap="pickStatus"
      hover-class="hover"
    >在用</view>
    <view
      class="seg {{status === 'archived' ? 'seg-on' : ''}}"
      data-status="archived"
      bindtap="pickStatus"
      hover-class="hover"
    >已停用</view>
  </view>

  <!-- 分类筛选 -->
  <scroll-view wx:if="{{categories.length > 0}}" class="chips" scroll-x enable-flex>
    <view class="chip {{category === '' ? 'chip-on' : ''}}" data-cat="" bindtap="pickCategory" hover-class="hover">全部</view>
    <view
      wx:for="{{categories}}"
      wx:key="*this"
      class="chip {{category === item ? 'chip-on' : ''}}"
      data-cat="{{item}}"
      bindtap="pickCategory"
      hover-class="hover"
    >{{item}}</view>
  </scroll-view>

  <!-- 低库存下钻的筛选提示 -->
  <view wx:if="{{lowFilter}}" class="filter-pill">
    <text class="fp-txt">只看库存预警（{{total}} 项）</text>
    <view class="fp-x" catchtap="clearLowFilter" hover-class="hover">清除 ×</view>
  </view>

  <!-- 汇总 -->
  <view class="summary">
    <text class="f-sm t-sub">共 {{total}} 件物品{{category ? ' · ' + category : ''}}{{status === 'archived' ? ' · 已停用' : ''}}</text>
  </view>

  <!-- 列表 -->
  <view class="wrap list-wrap">
    <!-- 首屏加载占位：之前 loading 期间整片空白，现在用骨架卡撑住 -->
    <block wx:if="{{loading && list.length === 0}}">
      <view class="card" wx:for="{{[1,2,3]}}" wx:key="*this">
        <view class="sk-line" style="width:46%"></view>
        <view class="sk-line" style="width:72%;margin-bottom:0"></view>
      </view>
    </block>
    <view wx:if="{{!loading && list.length === 0}}" class="empty">
      <view class="empty-icon"><view class="ei-box"></view></view>
      <view class="empty-title">{{emptyTitle}}</view>
      <view class="empty-desc">{{emptyDesc}}</view>
    </view>
    <view
      wx:for="{{list}}"
      wx:key="id"
      class="item-card {{item.isArchived ? 'item-card-off' : ''}}"
      data-id="{{item.id}}"
      bindtap="openItem"
      hover-class="hover"
    >
      <view class="ic-head">
        <view class="grow">
          <view class="ic-name ellipsis">{{item.name}}</view>
          <view class="ic-code">{{item.code}}{{item.spec ? ' · ' + item.spec : ''}}</view>
        </view>
        <view class="ic-qty">
          <text class="ic-qty-num {{item.isLow ? 't-out' : ''}}">{{item.qty}}</text>
          <text class="ic-qty-unit">{{item.unit || '个'}}</text>
        </view>
      </view>
      <view class="ic-tags" wx:if="{{item.location || item.category || item.isLow || item.isArchived}}">
        <text wx:if="{{item.isArchived}}" class="tag tag-gray">已停用</text>
        <text wx:if="{{item.location}}" class="tag tag-gray">{{item.location}}</text>
        <text wx:if="{{item.category}}" class="tag tag-blue">{{item.category}}</text>
        <text wx:if="{{item.isLow}}" class="tag tag-orange">库存偏低</text>
      </view>
    </view>

    <view wx:if="{{loadingMore}}" class="list-foot">加载中…</view>
    <view wx:elif="{{list.length > 0 && !hasMore}}" class="list-foot">没有更多了</view>
  </view>

  <!-- 新增按钮：只有主管及以上能建档；看历史停用档案时不需要 -->
  <view wx:if="{{caps.item_create && status === 'active'}}" class="fab" bindtap="goCreate" hover-class="hover-scale">+</view>
</view>
