<view class="page page-tab">
  <!-- 搜索 -->
  <view class="search-bar">
    <view class="search-wrap">
      <view class="search-ico"></view>
      <input
        class="search-input"
        value="{{keyword}}"
        placeholder="搜索名称 / 编号 / 规格 / 位置"
        placeholder-class="field-placeholder"
        confirm-type="search"
        bindinput="onKeywordInput"
        bindconfirm="reload"
      />
      <view wx:if="{{keyword}}" class="search-clear" bindtap="clearKeyword">×</view>
    </view>
  </view>

  <!-- 分类筛选 -->
  <scroll-view wx:if="{{categories.length > 0}}" class="chips" scroll-x enable-flex>
    <view class="chip {{category === '' ? 'chip-on' : ''}}" data-cat="" bindtap="pickCategory">全部</view>
    <view
      wx:for="{{categories}}"
      wx:key="*this"
      class="chip {{category === item ? 'chip-on' : ''}}"
      data-cat="{{item}}"
      bindtap="pickCategory"
    >{{item}}</view>
  </scroll-view>

  <!-- 汇总 -->
  <view class="summary">
    <text class="f-sm t-sub">共 {{total}} 件物品{{category ? ' · ' + category : ''}}</text>
  </view>

  <!-- 列表 -->
  <view class="wrap list-wrap">
    <view wx:if="{{!loading && list.length === 0}}" class="empty">
      <view class="empty-icon"><view class="ei-box"></view></view>
      <view class="empty-title">{{keyword || category ? '没有找到匹配的物品' : '还没有物品档案'}}</view>
      <view class="empty-desc">{{keyword || category ? '换个关键词或分类试试' : (caps.item_create ? '点击右下角 + 新建，或用电脑端工具批量导入' : '仓库还没有建档，请联系主管或管理员')}}</view>
    </view>

    <view
      wx:for="{{list}}"
      wx:key="id"
      class="item-card"
      data-id="{{item.id}}"
      bindtap="openItem"
    >
      <view class="ic-head">
        <view class="grow">
          <view class="ic-name ellipsis">{{item.name}}</view>
          <view class="ic-code">{{item.code}}{{item.spec ? ' · ' + item.spec : ''}}</view>
        </view>
        <view class="ic-qty">
          <text class="ic-qty-num {{item.qty <= 0 ? 't-out' : ''}}">{{item.qty}}</text>
          <text class="ic-qty-unit">{{item.unit || '个'}}</text>
        </view>
      </view>
      <view class="ic-tags" wx:if="{{item.location || item.category || item.qty <= item.min_qty}}">
        <text wx:if="{{item.location}}" class="tag tag-gray">{{item.location}}</text>
        <text wx:if="{{item.category}}" class="tag tag-blue">{{item.category}}</text>
        <text wx:if="{{item.qty <= item.min_qty}}" class="tag tag-orange">库存偏低</text>
      </view>
    </view>

    <view wx:if="{{loadingMore}}" class="list-foot">加载中…</view>
    <view wx:elif="{{list.length > 0 && !hasMore}}" class="list-foot">没有更多了</view>
  </view>

  <!-- 新增按钮：只有主管及以上能建档 -->
  <view wx:if="{{caps.item_create}}" class="fab" bindtap="goCreate">+</view>
</view>
