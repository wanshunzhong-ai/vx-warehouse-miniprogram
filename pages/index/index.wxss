/* ============ 顶部身份区（三套主题色） ============ */

.hero {
  padding: 44rpx 36rpx 44rpx;
  border-radius: 0 0 36rpx 36rpx;
  color: #ffffff;
}

.hero-admin {
  background: linear-gradient(140deg, #7c4dff 0%, #6d3df0 55%, #5b2fd6 100%);
  box-shadow: 0 14rpx 36rpx rgba(109, 61, 240, 0.26);
}

.hero-manager {
  background: linear-gradient(140deg, #3d7bff 0%, #2f6df6 55%, #2456d8 100%);
  box-shadow: 0 14rpx 36rpx rgba(47, 109, 246, 0.26);
}

.hero-staff {
  background: linear-gradient(140deg, #12c98a 0%, #0ca678 55%, #0a8a64 100%);
  box-shadow: 0 14rpx 36rpx rgba(12, 166, 120, 0.26);
}

.hero-row {
  display: flex;
  align-items: center;
}

.hero-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.22);
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 600;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.hero-name {
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.3;
}

.hero-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.78);
}

.hero-badge {
  flex-shrink: 0;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.22);
  border: 1rpx solid rgba(255, 255, 255, 0.4);
  font-size: 24rpx;
  font-weight: 600;
}

.hero-foot {
  margin-top: 32rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.22);
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 25rpx;
  color: rgba(255, 255, 255, 0.86);
}

.hero-date {
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* ============ 待办卡 ============ */

.todo-card {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #ffffff 0%, #f7f4ff 100%);
  border: 1rpx solid #ece4ff;
}

.todo-left {
  width: 180rpx;
  flex-shrink: 0;
  text-align: center;
  border-right: 1rpx solid #eee7ff;
  margin-right: 24rpx;
}

.todo-num {
  font-size: 60rpx;
  font-weight: 700;
  color: #7c4dff;
  line-height: 1.1;
}

.todo-lbl {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #767c87;
}

.todo-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 6rpx 0;
}

.todo-name {
  font-size: 27rpx;
  color: #151922;
  font-weight: 500;
}

.todo-meta {
  font-size: 24rpx;
  color: #7b828d;
}

.todo-empty {
  font-size: 26rpx;
  color: #9aa1ad;
  padding: 16rpx 0;
}

.mi-arrow {
  font-size: 40rpx;
  color: #c8cdd6;
  margin-left: 12rpx;
}

/* ============ 数字栅格 ============ */

.grid4 {
  display: flex;
}

.g4-cell {
  flex: 1;
  text-align: center;
}

.g4-num {
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.2;
  color: #151922;
}

.g4-lbl {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #767c87;
}

.grid3 {
  display: flex;
}

.g3-cell {
  flex: 1;
  text-align: center;
}

.g3-num {
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.2;
  color: #151922;
}

.g3-lbl {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #767c87;
}

.c-admin { color: #7c4dff; }
.c-manager { color: #2f6df6; }
.c-staff { color: #0ca678; }
/* 与 tag-orange / t-warn 同一个橙，预警色全站统一 */
.c-warn { color: #ea580c; }

.flow-row {
  display: flex;
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #f1f3f7;
}

.flow-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.flow-lbl {
  font-size: 24rpx;
  color: #7b828d;
}

.flow-val {
  margin-top: 8rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #151922;
}

/* ============ 操作宫格 ============ */

.act-grid {
  display: flex;
  flex-wrap: wrap;
}

/* 两列版：条目少时把热区放大一倍（员工「更多操作」用） */
.act-grid-2 .act {
  width: 50%;
}

.act {
  width: 33.3333%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 18rpx 0;
}

.act-ico {
  width: 84rpx;
  height: 84rpx;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #ffffff;
}

.act-violet {
  background: linear-gradient(135deg, #9575ff, #7c4dff);
  box-shadow: 0 8rpx 18rpx rgba(124, 77, 255, 0.26);
}

.act-blue {
  background: linear-gradient(135deg, #5b93ff, #2f6df6);
  box-shadow: 0 8rpx 18rpx rgba(47, 109, 246, 0.26);
}

.act-green {
  background: linear-gradient(135deg, #24d29b, #0ca678);
  box-shadow: 0 8rpx 18rpx rgba(12, 166, 120, 0.24);
}

.act-txt {
  margin-top: 12rpx;
  font-size: 25rpx;
  color: #4b5563;
}

/* ============ 记录行 ============ */

.rec {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f1f3f7;
}

.rec:last-child {
  border-bottom: none;
}

.rec-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.dot-in { background: #16a34a; }
.dot-out { background: #f97316; }

.rec-title {
  font-size: 28rpx;
  color: #151922;
  font-weight: 500;
}

.rec-meta {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #7b828d;
}

.rec-qty {
  font-size: 30rpx;
  font-weight: 600;
  margin-left: 16rpx;
}

.empty-inline {
  padding: 40rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #a3a9b3;
}

/* ============ 库存预警 ============ */

.low {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f1f3f7;
}

.low:last-child {
  border-bottom: none;
}

.low-name {
  font-size: 28rpx;
  color: #151922;
}

.low-meta {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #7b828d;
}

.low-qty {
  margin-left: 16rpx;
}

/* ============ 主管申请卡 ============ */

.apply-tip {
  margin-top: 24rpx;
  font-size: 24rpx;
  color: #8b8f99;
  line-height: 1.6;
}

.apply-btn {
  width: 100%;
  margin-top: 24rpx;
}

/* ============ 员工：扫码入库 / 扫码出库 两个方向 ============ */

.dir-row {
  display: flex;
  gap: 22rpx;
}

.dir-card {
  flex: 1;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 44rpx 20rpx 38rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 12rpx 32rpx rgba(21, 25, 34, 0.08);
  border-top: 8rpx solid transparent;
}

.dir-in { border-top-color: #22c55e; }
.dir-out { border-top-color: #fb923c; }

.dir-ico {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 22rpx;
}

.dir-in .dir-ico { background: linear-gradient(135deg, #22c55e, #16a34a); }
.dir-out .dir-ico { background: linear-gradient(135deg, #fb923c, #f97316); }

.dir-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #151922;
}

.dir-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #7b828d;
}

.dir-tip {
  margin-top: 22rpx;
  text-align: center;
  font-size: 24rpx;
  color: #8a9099;
}

/* ============ 页脚提示 ============ */

.tips {
  margin-top: 36rpx;
  text-align: center;
  font-size: 24rpx;
  color: #8a9099;
  line-height: 1.6;
}
