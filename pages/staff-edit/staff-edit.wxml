<view class="page">
  <!-- ===================== 添加账号 ===================== -->
  <block wx:if="{{mode === 'add'}}">
    <view class="wrap">
      <view wx:if="{{!isAdmin}}" class="notice notice-blue">
        你添加的账号会先进入「待审批」，需要管理员通过后才能登录。
      </view>
      <view wx:else class="notice notice-purple">
        管理员创建的账号立即生效，请把账号密码转告本人。
      </view>

      <view class="card">
        <view class="card-title">账号信息</view>

        <view class="field">
          <view class="field-label"><text class="req">*</text>登录账号</view>
          <input
            class="field-input field-input-left"
            value="{{form.username}}"
            maxlength="24"
            placeholder="字母数字，如 zhangsan"
            placeholder-class="field-placeholder"
            bindinput="onInput"
            data-key="username"
          />
        </view>

        <view class="field">
          <view class="field-label"><text class="req">*</text>姓名</view>
          <input
            class="field-input field-input-left"
            value="{{form.name}}"
            placeholder="真实姓名，用于记录操作人"
            placeholder-class="field-placeholder"
            bindinput="onInput"
            data-key="name"
          />
        </view>

        <view class="field">
          <view class="field-label">手机号</view>
          <input
            class="field-input field-input-left"
            type="number"
            value="{{form.phone}}"
            maxlength="11"
            placeholder="选填"
            placeholder-class="field-placeholder"
            bindinput="onInput"
            data-key="phone"
          />
        </view>

        <view class="field">
          <view class="field-label">部门</view>
          <input
            class="field-input field-input-left"
            value="{{form.dept}}"
            placeholder="选填，如 仓储部"
            placeholder-class="field-placeholder"
            bindinput="onInput"
            data-key="dept"
          />
        </view>
      </view>

      <!-- 身份 -->
      <view class="card">
        <view class="card-title">身份</view>
        <block wx:if="{{isAdmin}}">
          <view
            wx:for="{{roleOptions}}"
            wx:key="key"
            class="role-opt {{form.role === item.key ? 'role-on' : ''}}"
            data-role="{{item.key}}"
            bindtap="pickRole"
          >
            <view class="ro-radio"></view>
            <view class="grow">
              <view class="ro-label">{{item.label}}</view>
              <view class="ro-desc">{{item.desc}}</view>
            </view>
          </view>
        </block>
        <block wx:else>
          <view class="role-fixed">
            <view class="rf-label">员工</view>
            <view class="rf-desc">主管只能添加员工账号。如果需要主管或管理员，请联系管理员创建。</view>
          </view>
        </block>
      </view>

      <!-- 初始密码 -->
      <view class="card">
        <view class="card-title">初始密码</view>
        <view class="field">
          <view class="field-label">密码</view>
          <input
            class="field-input field-input-left"
            value="{{form.password}}"
            maxlength="32"
            placeholder="留空则自动生成一个随机密码"
            placeholder-class="field-placeholder"
            bindinput="onInput"
            data-key="password"
          />
        </view>
        <view class="hint-inline">对方首次登录后会被提示修改密码。</view>
      </view>

      <!-- 申请说明 -->
      <view class="card">
        <view class="card-title">申请说明</view>
        <textarea
          class="textarea"
          value="{{form.remark}}"
          placeholder="选填，例如：新入职，负责五金库出入库"
          placeholder-class="field-placeholder"
          maxlength="200"
          bindinput="onInput"
          data-key="remark"
        />
      </view>

      <view wx:if="{{errorText}}" class="err-box">{{errorText}}</view>

      <button
        class="btn btn-primary submit {{saving ? 'btn-disabled' : ''}}"
        loading="{{saving}}"
        disabled="{{saving}}"
        bindtap="onSave"
      >{{saving ? '提交中…' : (isAdmin ? '创建账号' : '提交审批')}}</button>
    </view>
  </block>

  <!-- ===================== 账号详情 ===================== -->
  <block wx:else>
    <block wx:if="{{detail}}">
      <view class="detail-head">
        <view class="dh-avatar">{{detail.initial}}</view>
        <view class="dh-name">{{detail.name}}</view>
        <view class="dh-tags">
          <text class="tag {{detail.role === 'admin' ? 'tag-purple' : (detail.role === 'manager' ? 'tag-blue' : 'tag-green')}}">{{detail.roleLabel}}</text>
          <text class="tag {{detail.statusClass}}">{{detail.statusLabel}}</text>
        </view>
      </view>

      <view class="wrap">
        <!-- 基本信息 -->
        <view class="card">
          <view class="card-title">账号信息</view>
          <view class="info-row">
            <text class="info-lbl">登录账号</text>
            <text class="info-val">{{detail.username}}</text>
          </view>
          <view class="info-row">
            <text class="info-lbl">手机号</text>
            <text class="info-val">{{detail.phone || '—'}}</text>
          </view>
          <view class="info-row">
            <text class="info-lbl">部门</text>
            <text class="info-val">{{detail.dept || '—'}}</text>
          </view>
          <view class="info-row">
            <text class="info-lbl">提交人</text>
            <text class="info-val">{{detail.created_by_name || '系统创建'}}</text>
          </view>
          <view class="info-row">
            <text class="info-lbl">提交时间</text>
            <text class="info-val">{{detail.createdText}}</text>
          </view>
          <view class="info-row">
            <text class="info-lbl">上次登录</text>
            <text class="info-val">{{detail.lastLoginText}}（累计 {{detail.login_count}} 次）</text>
          </view>
          <view wx:if="{{detail.remark}}" class="info-row">
            <text class="info-lbl">申请说明</text>
            <text class="info-val">{{detail.remark}}</text>
          </view>
        </view>

        <!-- 审批（管理员 + 待审批） -->
        <block wx:if="{{isAdmin && detail.status === 'pending'}}">
          <view class="card review-card">
            <view class="card-title">待你审批</view>
            <view class="rv-desc">通过后该账号立即可登录；驳回后对方会看到「申请已被驳回」。</view>

            <view class="rv-label">通过后授予的身份</view>
            <view class="role-chips">
              <view
                wx:for="{{roleOptions}}"
                wx:key="key"
                class="chip chip-sm {{newRole === item.key ? 'chip-on' : ''}}"
                data-role="{{item.key}}"
                bindtap="pickNewRole"
              >{{item.label}}</view>
            </view>

            <view class="rv-label">审批意见（可选）</view>
            <input
              class="rv-input"
              value="{{reviewNote}}"
              placeholder="例如：已核对入职信息"
              placeholder-class="field-placeholder"
              bindinput="onReviewNoteInput"
            />

            <button class="btn btn-primary submit" bindtap="doApprove">通过并启用</button>
            <view class="btn btn-danger submit" style="margin-top:20rpx" bindtap="doReject">驳回申请</view>
          </view>
        </block>

        <!-- 审批结果 -->
        <view wx:if="{{detail.reviewed_by_name}}" class="card">
          <view class="card-title">审批记录</view>
          <view class="info-row">
            <text class="info-lbl">审批人</text>
            <text class="info-val">{{detail.reviewed_by_name}}</text>
          </view>
          <view class="info-row">
            <text class="info-lbl">审批意见</text>
            <text class="info-val">{{detail.review_note || '—'}}</text>
          </view>
        </view>

        <!-- 管理操作（管理员） -->
        <block wx:if="{{isAdmin && detail.status !== 'pending'}}">
          <view class="card">
            <view class="card-title">调整身份</view>
            <view class="role-chips">
              <view
                wx:for="{{roleOptions}}"
                wx:key="key"
                class="chip chip-sm {{newRole === item.key ? 'chip-on' : ''}}"
                data-role="{{item.key}}"
                bindtap="pickNewRole"
              >{{item.label}}</view>
            </view>
            <view class="btn btn-ghost submit" bindtap="saveRole">保存身份</view>
          </view>

          <view class="card">
            <view class="card-title">重置密码</view>
            <input
              class="rv-input"
              value="{{resetPwd}}"
              maxlength="32"
              placeholder="留空则随机生成"
              placeholder-class="field-placeholder"
              bindinput="onResetPwdInput"
            />
            <view class="btn btn-ghost submit" bindtap="doResetPassword">重置并踢下线</view>
          </view>

          <view class="card">
            <view class="card-title">账号状态</view>
            <view class="btn {{detail.status === 'disabled' ? 'btn-primary' : 'btn-danger'}} submit" bindtap="toggleStatus">
              {{detail.status === 'disabled' ? '恢复启用' : '停用该账号'}}
            </view>
            <view class="btn btn-plain submit" style="margin-top:20rpx" bindtap="doDelete">删除账号</view>
          </view>
        </block>

        <!-- 主管视角提示 -->
        <view wx:if="{{!isAdmin}}" class="notice notice-blue">
          {{detail.status === 'pending' ? '已提交给管理员审批，通过后对方即可登录。' : (detail.status === 'rejected' ? '这条申请被驳回了，可以修改信息后重新提交。' : '账号已生效，可以把账号密码转告本人。')}}
        </view>
      </view>
    </block>

    <view wx:else class="wrap">
      <view class="card" style="margin-top:120rpx;text-align:center">
        <view class="t-sub">正在加载…</view>
      </view>
    </view>
  </block>
</view>
