<view class="page page-tab">
  <!-- 入库 / 出库 是两个独立方向，各自一个入口 -->
  <view class="dir-hero">
    <view class="dir-title">你要做什么？</view>
    <view class="dir-row">
      <view class="dir-card dir-in" data-type="in" bindtap="onScan" hover-class="dir-hover">
        <view class="dir-ico">入</view>
        <view class="dir-name">扫码入库</view>
        <view class="dir-desc">采购到货 · 归还</view>
      </view>
      <view class="dir-card dir-out" data-type="out" bindtap="onScan" hover-class="dir-hover">
        <view class="dir-ico">出</view>
        <view class="dir-name">扫码出库</view>
        <view class="dir-desc">车间领用 · 发放</view>
      </view>
    </view>
    <view class="dir-tip">选好方向再扫，数量页不用再选一次</view>
  </view>

  <view class="wrap">
    <view class="card">
      <view class="card-title">手动输入编号</view>
      <view class="type-row">
        <view
          class="type-chip {{manualType === 'in' ? 'type-on-in' : ''}}"
          data-type="in"
          bindtap="pickManualType"
          hover-class="hover"
        >入库</view>
        <view
          class="type-chip {{manualType === 'out' ? 'type-on-out' : ''}}"
          data-type="out"
          bindtap="pickManualType"
          hover-class="hover"
        >出库</view>
      </view>
      <view class="manual-row">
        <input
          class="manual-input"
          value="{{manualCode}}"
          placeholder="例如 WP0001"
          placeholder-class="field-placeholder"
          confirm-type="search"
          bindinput="onInput"
          bindconfirm="onManualSearch"
        />
        <view class="btn btn-primary btn-sm manual-btn" bindtap="onManualSearch" hover-class="hover">查询</view>
      </view>
    </view>

    <view class="card" wx:if="{{recent.length > 0}}">
      <view class="card-title">
        <text>最近扫描</text>
        <text class="t-dim f-sm" bindtap="clearRecent">清空</text>
      </view>
      <view
        wx:for="{{recent}}"
        wx:key="code"
        class="list-item"
        data-code="{{item.code}}"
        bindtap="openRecent"
       hover-class="hover">
        <view class="recent-badge">{{item.initial}}</view>
        <view class="grow">
          <view class="f-md ellipsis">{{item.name || item.code}}</view>
          <view class="f-xs t-dim" style="margin-top:6rpx">{{item.code}} · {{item.timeText}}</view>
        </view>
        <view class="scan-arrow">›</view>
      </view>
    </view>

    <view class="card">
      <view class="card-title">使用说明</view>
      <view class="step">
        <view class="step-no">1</view>
        <view class="grow">先在「物品」里建好档案，或用电脑端工具批量建档并打印二维码标签</view>
      </view>
      <view class="step">
        <view class="step-no">2</view>
        <view class="grow">把二维码贴到物品或货架上</view>
      </view>
      <view class="step">
        <view class="step-no">3</view>
        <view class="grow">按业务选「扫码入库」或「扫码出库」，扫完填数量即可，库存和流水自动更新</view>
      </view>
    </view>
  </view>
</view>
