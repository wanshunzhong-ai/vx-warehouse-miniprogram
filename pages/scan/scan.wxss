.dir-hero {
  background: linear-gradient(160deg, #3d7bff 0%, #2456d8 100%);
  padding: 40rpx 28rpx 84rpx;
  border-bottom-left-radius: 44rpx;
  border-bottom-right-radius: 44rpx;
}

.dir-title {
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.92);
  margin-bottom: 24rpx;
  padding-left: 6rpx;
}

.dir-row {
  display: flex;
  gap: 22rpx;
}

/* ---------- 两个方向的大卡片 ---------- */

.dir-card {
  flex: 1;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 40rpx 20rpx 34rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 14rpx 32rpx rgba(10, 30, 80, 0.18);
  border-top: 8rpx solid transparent;
}

.dir-in { border-top-color: #22c55e; }
.dir-out { border-top-color: #fb923c; }

.dir-hover {
  transform: scale(0.97);
  opacity: 0.94;
}

.dir-ico {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 46rpx;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 22rpx;
}

.dir-in .dir-ico { background: linear-gradient(135deg, #22c55e, #16a34a); }
.dir-out .dir-ico { background: linear-gradient(135deg, #fb923c, #f97316); }

.dir-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #151922;
}

.dir-desc {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #8a9099;
}

.dir-tip {
  margin-top: 26rpx;
  text-align: center;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.72);
}

.wrap {
  padding: 0 28rpx 40rpx;
  margin-top: -48rpx;
}

/* ---------- 手动输入的方向切换 ---------- */

.type-row {
  display: flex;
  gap: 18rpx;
  margin-bottom: 22rpx;
}

.type-chip {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: 14rpx;
  background: #f4f6fa;
  color: #6b7280;
  font-size: 28rpx;
  transition: all 0.16s;
}

.type-on-in {
  background: linear-gradient(135deg, #22c55e, #16a34a);
  color: #ffffff;
  font-weight: 600;
}

.type-on-out {
  background: linear-gradient(135deg, #fb923c, #f97316);
  color: #ffffff;
  font-weight: 600;
}

.manual-row {
  display: flex;
  align-items: center;
}

.manual-input {
  flex: 1;
  height: 82rpx;
  padding: 0 26rpx;
  background: #f7f8fb;
  border-radius: 16rpx;
  font-size: 30rpx;
  color: #151922;
  margin-right: 18rpx;
}

.manual-btn {
  width: 150rpx;
  height: 82rpx;
  line-height: 82rpx;
  font-size: 28rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}

/* ---------- 最近扫描 ---------- */

.recent-badge {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #eef3ff, #dde8ff);
  color: #2f6df6;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 22rpx;
  flex-shrink: 0;
}

.scan-arrow {
  font-size: 44rpx;
  color: #c3c9d4;
  line-height: 1;
}

/* ---------- 说明 ---------- */

.step {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #4b5563;
  line-height: 1.6;
}

.step-no {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #eef3ff;
  color: #2f6df6;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
  margin-top: 4rpx;
}
