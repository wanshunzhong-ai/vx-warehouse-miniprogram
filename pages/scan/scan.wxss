.scan-hero {
  background: linear-gradient(160deg, #2f6df6 0%, #2456d8 100%);
  padding: 48rpx 28rpx 96rpx;
  border-bottom-left-radius: 44rpx;
  border-bottom-right-radius: 44rpx;
}

.scan-box {
  background: rgba(255, 255, 255, 0.98);
  border-radius: 28rpx;
  padding: 60rpx 32rpx 52rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 18rpx 40rpx rgba(10, 30, 80, 0.2);
}

.scan-box-hover {
  transform: scale(0.985);
  opacity: 0.94;
}

.frame {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 36rpx;
  overflow: hidden;
}

.corner {
  position: absolute;
  width: 62rpx;
  height: 62rpx;
}

.c-tl {
  left: 0;
  top: 0;
  border-left: 10rpx solid #2f6df6;
  border-top: 10rpx solid #2f6df6;
  border-top-left-radius: 18rpx;
}

.c-tr {
  right: 0;
  top: 0;
  border-right: 10rpx solid #2f6df6;
  border-top: 10rpx solid #2f6df6;
  border-top-right-radius: 18rpx;
}

.c-bl {
  left: 0;
  bottom: 0;
  border-left: 10rpx solid #2f6df6;
  border-bottom: 10rpx solid #2f6df6;
  border-bottom-left-radius: 18rpx;
}

.c-br {
  right: 0;
  bottom: 0;
  border-right: 10rpx solid #2f6df6;
  border-bottom: 10rpx solid #2f6df6;
  border-bottom-right-radius: 18rpx;
}

.laser {
  position: absolute;
  left: 12rpx;
  right: 12rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: linear-gradient(90deg, rgba(47, 109, 246, 0), #2f6df6, rgba(47, 109, 246, 0));
  animation: scanmove 2.2s ease-in-out infinite;
}

@keyframes scanmove {
  0% { top: 18rpx; }
  50% { top: 176rpx; }
  100% { top: 18rpx; }
}

.scan-main {
  font-size: 38rpx;
  font-weight: 600;
  color: #151922;
}

.scan-hint {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #8a9099;
}

.wrap {
  padding: 0 28rpx 40rpx;
  margin-top: -60rpx;
}

/* 手动输入 */

.manual-row {
  display: flex;
  align-items: center;
}

.manual-input {
  flex: 1;
  height: 82rpx;
  padding: 0 26rpx;
  background: #f7f8fb;
  border-radius: 16rpx;
  font-size: 30rpx;
  color: #151922;
  margin-right: 18rpx;
}

.manual-btn {
  width: 150rpx;
  height: 82rpx;
  line-height: 82rpx;
  font-size: 28rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}

/* 最近扫描 */

.recent-badge {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #eef3ff, #dde8ff);
  color: #2f6df6;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 22rpx;
  flex-shrink: 0;
}

.scan-arrow {
  font-size: 44rpx;
  color: #c3c9d4;
  line-height: 1;
}

/* 说明 */

.step {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #4b5563;
  line-height: 1.6;
}

.step-no {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #eef3ff;
  color: #2f6df6;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
  margin-top: 4rpx;
}
