<view class="page">
  <!-- 手动输编号 -->
  <block wx:if="{{manual}}">
    <view class="wrap">
      <view class="card">
        <view class="card-title">输入物品编号</view>
        <view class="manual-row">
          <input
            class="manual-input"
            value="{{codeInput}}"
            placeholder="例如 WP0001"
            placeholder-class="field-placeholder"
            confirm-type="search"
            bindinput="onCodeInput"
            bindconfirm="onCodeConfirm"
          />
          <view class="btn btn-primary btn-sm manual-btn" bindtap="onCodeConfirm" hover-class="hover">查询</view>
        </view>
        <view class="btn btn-plain" style="margin-top:24rpx" bindtap="scanCode" hover-class="hover">扫码代替输入</view>
      </view>
    </view>
  </block>

  <block wx:else>
    <!-- 加载中 -->
    <view wx:if="{{loading}}" class="loading-box">
      <view class="spinner"></view>
      <text class="t-sub f-sm">正在查找物品…</text>
    </view>

    <block wx:elif="{{!item}}">
      <!-- 未建档 -->
      <view class="wrap">
        <view class="card notfound">
          <view class="nf-ico">?</view>
          <view class="nf-title">这个编号还没有建档</view>
          <view class="nf-code">{{code}}</view>
          <view class="nf-desc">{{caps.item_create ? '可以先建立物品档案，建档后立刻就能出入库。' : '请联系主管或管理员先为该物品建档。'}}</view>
          <button wx:if="{{caps.item_create}}" class="btn btn-primary" bindtap="goCreate">立即建档</button>
          <view class="btn btn-plain" style="margin-top:20rpx" bindtap="scanCode" hover-class="hover">换一个编号</view>
          <view class="btn btn-plain" style="margin-top:20rpx" bindtap="goBack" hover-class="hover">返回</view>
        </view>
      </view>
    </block>

    <block wx:else>
      <!-- 物品信息 -->
      <view class="item-head">
        <view class="ih-name">{{item.name}}</view>
        <view class="ih-meta">{{item.code}}{{item.spec ? ' · ' + item.spec : ''}}{{item.location ? ' · ' + item.location : ''}}</view>
        <view class="ih-qty-row">
          <view class="ih-qty-box">
            <view class="ih-qty">{{item.qty}}</view>
            <view class="ih-qty-lbl">当前库存（{{item.unit || '个'}}）</view>
          </view>
          <view class="ih-link" bindtap="goDetail" hover-class="hover">查看详情 ›</view>
        </view>
      </view>

      <view class="wrap body">
        <!-- 成功结果 -->
        <block wx:if="{{result}}">
          <view class="card result-card">
            <view class="res-badge {{result.type === 'in' ? 'res-in' : 'res-out'}}">
              {{result.type === 'in' ? '入库成功' : '出库成功'}}
            </view>
            <view class="res-line">
              <text class="t-sub f-sm">{{item.name}}</text>
            </view>
            <view class="res-qty {{result.type === 'in' ? 't-in' : 't-out'}}">
              {{result.type === 'in' ? '+' : '-'}}{{result.qty}}
            </view>
            <view class="res-flow">
              <text class="f-sm t-dim">{{result.before}} → </text>
              <text class="f-md bold">{{result.after}}</text>
              <text class="f-sm t-dim"> {{item.unit || '个'}}</text>
            </view>
            <view class="res-operator">操作人：{{result.operator}}</view>
            <button class="btn btn-primary" style="margin-top:36rpx" bindtap="resetForm">继续操作</button>
            <view class="btn btn-plain" style="margin-top:20rpx" bindtap="scanCode" hover-class="hover">扫下一个</view>
            <view class="btn btn-plain" style="margin-top:20rpx" bindtap="goBack" hover-class="hover">完成</view>
          </view>
        </block>

        <!-- 操作表单 -->
        <block wx:else>
          <view class="seg">
            <view class="seg-item {{type === 'in' ? 'seg-in' : ''}}" data-type="in" bindtap="switchType" hover-class="hover">
              入库
            </view>
            <view class="seg-item {{type === 'out' ? 'seg-out' : ''}}" data-type="out" bindtap="switchType" hover-class="hover">
              出库
            </view>
          </view>

          <view class="card">
            <view class="card-title">数量</view>
            <view class="qty-row">
              <view class="qty-btn" bindtap="minusOne" hover-class="hover">−</view>
              <input
                class="qty-input"
                type="number"
                value="{{qtyText}}"
                bindinput="onQtyInput"
                bindblur="onQtyBlur"
                placeholder="0"
                placeholder-class="field-placeholder"
              />
              <view class="qty-btn" bindtap="plusOne" hover-class="hover">+</view>
            </view>
            <view class="quick-qty">
              <view class="qq" wx:for="{{[1,5,10,20]}}" wx:key="*this" data-v="{{item}}" bindtap="setQty" hover-class="hover">{{item}}</view>
            </view>
          </view>

          <view class="card">
            <view class="field">
              <view class="field-label">操作人</view>
              <view class="field-static">{{operatorName}}<text class="op-role">{{roleLabel}}</text></view>
            </view>
            <view class="field">
              <view class="field-label">备注</view>
              <input
                class="field-input"
                value="{{note}}"
                placeholder="选填，如领用部门、来源单号"
                placeholder-class="field-placeholder"
                bindinput="onNoteInput"
              />
            </view>
          </view>

          <button
            class="btn {{type === 'in' ? 'btn-in' : 'btn-out'}} submit {{submitting ? 'btn-disabled' : ''}}"
            loading="{{submitting}}"
            disabled="{{submitting}}"
            bindtap="submit"
          >{{submitting ? '提交中…' : (type === 'in' ? '确认入库' : '确认出库')}}</button>

          <view class="scan-again" bindtap="scanCode" hover-class="hover">再扫一个</view>
        </block>
      </view>
    </block>
  </block>
</view>
