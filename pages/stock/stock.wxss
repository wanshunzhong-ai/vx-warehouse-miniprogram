.loading-box {
  padding: 200rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.spinner {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 6rpx solid #dfe5f0;
  border-top-color: #2f6df6;
  animation: spin 0.8s linear infinite;
  margin-bottom: 24rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* ---------- 未建档 ---------- */

.notfound {
  text-align: center;
  padding: 56rpx 40rpx 48rpx;
  margin-top: 60rpx;
}

.nf-ico {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #f2f5fb;
  color: #2f6df6;
  font-size: 56rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 28rpx;
}

.nf-title {
  font-size: 34rpx;
  font-weight: 600;
}

.nf-code {
  margin: 18rpx 0;
  display: inline-block;
  padding: 10rpx 26rpx;
  background: #f4f6fa;
  border-radius: 12rpx;
  font-size: 30rpx;
  color: #2f6df6;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.nf-desc {
  font-size: 26rpx;
  color: #8a9099;
  line-height: 1.6;
  margin-bottom: 40rpx;
}

/* 同族模板卡片：扫码时发现同型号已建档，套用它的信息省掉重复填写 */
.fam-card {
  margin: 0 0 28rpx;
  padding: 24rpx 26rpx;
  background: #f4f8ff;
  border: 2rpx solid #dbe7ff;
  border-radius: 16rpx;
  text-align: left;
}

.fam-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #151922;
  margin-bottom: 8rpx;
  word-break: break-all;
}

.fam-meta {
  font-size: 24rpx;
  color: #7b8494;
  line-height: 1.5;
  word-break: break-all;
}

/* ---------- 物品头部 ---------- */

.item-head {
  background: linear-gradient(160deg, #3d7bff 0%, #2456d8 100%);
  padding: 44rpx 36rpx 96rpx;
  border-bottom-left-radius: 44rpx;
  border-bottom-right-radius: 44rpx;
}

.ih-name {
  font-size: 42rpx;
  font-weight: 600;
  color: #ffffff;
  line-height: 1.3;
}

.ih-meta {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.78);
}

.ih-qty-row {
  margin-top: 40rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}

.ih-qty {
  font-size: 76rpx;
  font-weight: 600;
  color: #ffffff;
  line-height: 1;
}

.ih-qty-lbl {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.72);
}

.ih-link {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  padding: 10rpx 22rpx;
  background: rgba(255, 255, 255, 0.16);
  border-radius: 30rpx;
}

.body {
  padding: 0 28rpx 60rpx;
  margin-top: -56rpx;
}

/* ---------- 分段控件 ---------- */

.seg {
  display: flex;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 8rpx;
  box-shadow: 0 6rpx 24rpx rgba(21, 25, 34, 0.06);
  margin-bottom: 24rpx;
}

.seg-item {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: 16rpx;
  font-size: 30rpx;
  color: #6b7280;
  transition: all 0.16s;
}

.seg-in {
  background: linear-gradient(135deg, #22c55e, #16a34a);
  color: #ffffff;
  font-weight: 600;
}

.seg-out {
  background: linear-gradient(135deg, #fb923c, #f97316);
  color: #ffffff;
  font-weight: 600;
}

/* ---------- 已锁定方向的状态条 ---------- */

.dir-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 26rpx;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(21, 25, 34, 0.08);
}

.db-in { background: linear-gradient(135deg, #22c55e, #16a34a); }
.db-out { background: linear-gradient(135deg, #fb923c, #f97316); }

.db-left {
  display: flex;
  align-items: center;
}

.db-ico {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.24);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.db-txt {
  font-size: 30rpx;
  font-weight: 600;
  color: #ffffff;
}

.db-swap {
  font-size: 24rpx;
  color: #ffffff;
  padding: 10rpx 24rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.2);
}

/* ---------- 数量 ---------- */

.qty-row {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 0 8rpx;
}

.qty-btn {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #f2f5fb;
  color: #2f6df6;
  font-size: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 500;
}

.qty-input {
  width: 220rpx;
  text-align: center;
  font-size: 68rpx;
  font-weight: 600;
  color: #151922;
  height: 110rpx;
}

.quick-qty {
  display: flex;
  justify-content: center;
  gap: 18rpx;
  margin-top: 20rpx;
}

.qq {
  padding: 12rpx 32rpx;
  background: #f4f6fa;
  border-radius: 14rpx;
  font-size: 26rpx;
  color: #4b5563;
}

/* ---------- 提交 ---------- */

.submit {
  margin-top: 36rpx;
  width: 100%;
}

.scan-again {
  margin-top: 32rpx;
  text-align: center;
  font-size: 28rpx;
  color: #2f6df6;
  padding: 16rpx;
}

/* ---------- 成功结果 ---------- */

.result-card {
  text-align: center;
  padding: 56rpx 40rpx 44rpx;
}

.res-badge {
  display: inline-block;
  padding: 10rpx 32rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #ffffff;
}

.res-in { background: linear-gradient(135deg, #22c55e, #16a34a); }
.res-out { background: linear-gradient(135deg, #fb923c, #f97316); }

.res-line {
  margin-top: 32rpx;
}

.res-qty {
  margin-top: 16rpx;
  font-size: 84rpx;
  font-weight: 600;
  line-height: 1.1;
}

.res-flow {
  margin-top: 16rpx;
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 8rpx;
}

/* ---------- 手动输编号 ---------- */

.manual-row {
  display: flex;
  align-items: center;
}

.manual-input {
  flex: 1;
  height: 82rpx;
  padding: 0 26rpx;
  background: #f7f8fb;
  border-radius: 16rpx;
  font-size: 30rpx;
  color: #151922;
  margin-right: 18rpx;
}

.manual-btn {
  width: 150rpx;
  height: 82rpx;
  line-height: 82rpx;
  font-size: 28rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}

/* ---------- 只读操作人 ---------- */

.field-static {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: #151922;
}

.op-role {
  margin-left: 12rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  background: #eef2fa;
  color: #2f6df6;
  font-size: 22rpx;
}

.res-operator {
  margin-top: 18rpx;
  font-size: 24rpx;
  color: #9aa1ad;
}
