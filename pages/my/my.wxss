/* ---------- 账号卡 ---------- */

.me-card {
  margin: 28rpx 28rpx 0;
  padding: 34rpx 32rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  color: #ffffff;
}

.me-admin {
  background: linear-gradient(140deg, #7c4dff 0%, #6d3df0 100%);
  box-shadow: 0 12rpx 30rpx rgba(109, 61, 240, 0.24);
}

.me-manager {
  background: linear-gradient(140deg, #3d7bff 0%, #2f6df6 100%);
  box-shadow: 0 12rpx 30rpx rgba(47, 109, 246, 0.24);
}

.me-staff {
  background: linear-gradient(140deg, #12c98a 0%, #0ca678 100%);
  box-shadow: 0 12rpx 30rpx rgba(12, 166, 120, 0.24);
}

.me-avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.22);
  border: 1rpx solid rgba(255, 255, 255, 0.34);
  font-size: 44rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.me-name-row {
  display: flex;
  align-items: center;
}

.me-name {
  font-size: 38rpx;
  font-weight: 600;
}

.me-badge {
  margin-left: 14rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.22);
  border: 1rpx solid rgba(255, 255, 255, 0.38);
  font-size: 22rpx;
}

.me-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.me-arrow {
  font-size: 44rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-left: 12rpx;
}

.body {
  padding: 24rpx 28rpx 60rpx;
}

/* ---------- 待审批 ---------- */

.todo {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #ffffff 0%, #fff8ee 100%);
  border: 1rpx solid #ffe6cc;
  padding: 28rpx 30rpx;
}

.todo-num {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  background: #fff3e6;
  color: #ea580c;
  font-size: 44rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.todo-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #151922;
}

.todo-desc {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #9aa1ad;
}

.mi-arrow {
  font-size: 40rpx;
  color: #c8cdd6;
  margin-left: 12rpx;
}

/* ---------- 小统计 ---------- */

.mini-grid {
  display: flex;
}

.mini-cell {
  flex: 1;
  text-align: center;
}

.mini-num {
  font-size: 42rpx;
  font-weight: 600;
  color: #151922;
  line-height: 1.2;
}

.mini-lbl {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8a9099;
}

/* ---------- 权限说明 ---------- */

.ability {
  padding: 4rpx 0;
}

.ab-item {
  display: flex;
  align-items: flex-start;
  padding: 10rpx 0;
}

.ab-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-top: 14rpx;
  margin-right: 18rpx;
  flex-shrink: 0;
  background: #2f6df6;
}

.ab-txt {
  flex: 1;
  font-size: 26rpx;
  color: #4b5563;
  line-height: 1.6;
}

.ab-foot {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f1f3f7;
  font-size: 23rpx;
  color: #9aa1ad;
  line-height: 1.6;
}

/* ---------- 菜单 ---------- */

.menu-card {
  padding: 8rpx 30rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f5f7fa;
}

.menu-item:last-child {
  border-bottom: none;
}

.mi-ico {
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.mi-violet { background: linear-gradient(135deg, #9575ff, #7c4dff); }
.mi-blue { background: linear-gradient(135deg, #5b93ff, #2f6df6); }
.mi-green { background: linear-gradient(135deg, #24d29b, #0ca678); }
.mi-orange { background: linear-gradient(135deg, #fbbf6b, #f59e0b); }
.mi-red { background: linear-gradient(135deg, #fca5a5, #ef4444); }

.tips {
  margin-top: 40rpx;
  text-align: center;
  font-size: 22rpx;
  color: #a3a9b3;
  line-height: 1.7;
}
