<view class="page">
  <view class="pf-head">
    <view class="pf-avatar">{{me.initial}}</view>
    <view class="pf-name">{{me.name}}</view>
    <view class="pf-tags">
      <text class="tag {{me.role === 'admin' ? 'tag-purple' : (me.role === 'manager' ? 'tag-blue' : 'tag-green')}}">{{me.roleLabel}}</text>
      <text class="tag {{me.statusClass}}">{{me.statusLabel}}</text>
    </view>
    <view class="pf-desc">{{me.dept || '未设置部门'}} · 账号 {{me.username}}</view>
  </view>

  <view class="wrap">
    <view wx:if="{{force}}" class="notice notice-red">
      你的账号还在使用初始密码，请先在下方「修改密码」里改成自己的密码。
    </view>

    <!-- 修改密码 -->
    <view class="card">
      <view class="card-title">修改密码</view>

      <view class="field">
        <view class="field-label">当前密码</view>
        <input
          class="field-input"
          password
          value="{{pwd.old}}"
          maxlength="32"
          placeholder="请输入现在的密码"
          placeholder-class="field-placeholder"
          bindinput="onPwdInput"
          data-key="old"
        />
      </view>

      <view class="field">
        <view class="field-label">新密码</view>
        <input
          class="field-input"
          password
          value="{{pwd.new1}}"
          maxlength="32"
          placeholder="至少 6 位"
          placeholder-class="field-placeholder"
          bindinput="onPwdInput"
          data-key="new1"
        />
      </view>

      <view class="field">
        <view class="field-label">确认新密码</view>
        <input
          class="field-input"
          password
          value="{{pwd.new2}}"
          maxlength="32"
          placeholder="再输一次"
          placeholder-class="field-placeholder"
          bindinput="onPwdInput"
          data-key="new2"
        />
      </view>

      <view wx:if="{{pwdError}}" class="err-box">{{pwdError}}</view>

      <button
        class="btn btn-primary submit {{savingPwd ? 'btn-disabled' : ''}}"
        loading="{{savingPwd}}"
        disabled="{{savingPwd}}"
        bindtap="changePassword"
      >{{savingPwd ? '提交中…' : '修改密码'}}</button>
      <view class="hint-inline">修改后其他设备上的登录会立即失效。</view>
    </view>

    <!-- 资料 -->
    <view class="card">
      <view class="card-title">个人资料</view>

      <view class="field">
        <view class="field-label">姓名</view>
        <input
          class="field-input field-input-left"
          value="{{form.name}}"
          placeholder="真实姓名"
          placeholder-class="field-placeholder"
          bindinput="onInput"
          data-key="name"
        />
      </view>

      <view class="field">
        <view class="field-label">手机号</view>
        <input
          class="field-input field-input-left"
          type="number"
          maxlength="11"
          value="{{form.phone}}"
          placeholder="选填"
          placeholder-class="field-placeholder"
          bindinput="onInput"
          data-key="phone"
        />
      </view>

      <view class="field">
        <view class="field-label">部门</view>
        <input
          class="field-input field-input-left"
          value="{{form.dept}}"
          placeholder="选填"
          placeholder-class="field-placeholder"
          bindinput="onInput"
          data-key="dept"
        />
      </view>

      <view wx:if="{{errorText}}" class="err-box">{{errorText}}</view>

      <button
        class="btn btn-ghost submit {{savingProfile ? 'btn-disabled' : ''}}"
        loading="{{savingProfile}}"
        disabled="{{savingProfile}}"
        bindtap="saveProfile"
      >{{savingProfile ? '保存中…' : '保存资料'}}</button>
    </view>

    <!-- 只读信息 -->
    <view class="card">
      <view class="card-title">账号信息</view>
      <view class="info-row">
        <text class="info-lbl">登录账号</text>
        <text class="info-val">{{me.username}}</text>
      </view>
      <view class="info-row">
        <text class="info-lbl">身份</text>
        <text class="info-val">{{me.roleLabel}}{{me.created_by_name ? '（由 ' + me.created_by_name + ' 开通）' : ''}}</text>
      </view>
      <view class="info-row">
        <text class="info-lbl">上次登录</text>
        <text class="info-val">{{me.lastLoginText}}</text>
      </view>
      <view class="info-row">
        <text class="info-lbl">累计登录</text>
        <text class="info-val">{{me.login_count}} 次</text>
      </view>
    </view>

    <view class="card">
      <view class="btn btn-danger submit" style="margin-top:0" bindtap="onSignOut">退出登录</view>
    </view>

    <view class="tips">账号由管理员统一管理，忘记密码时请联系管理员重置。</view>
  </view>
</view>
